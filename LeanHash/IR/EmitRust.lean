/-
P3：HashIR → Rust。

対応（意味論 `Semantics.lean` と 1 対 1）:
| HashIR | Rust | 意味論 |
| :--- | :--- | :--- |
| `bin .add/.sub/.mul` | `a.wrapping_add(b)` など | BitVec の `+ - *`（mod 2^w） |
| `bin .xor/.and/.or` | `a ^ b`、`a & b`、`a | b` | BitVec の `^^^ &&& |||` |
| `shl a k` / `shr a k` | `a << k` / `a >> k`（k < 幅。`Kernel.wf`） | `<<<` / `>>>` |
| `ext a` | `a as u128` | `setWidth 128`（ゼロ拡張） |
| `trunc a` | `a as u64` | `setWidth 64`（下位 64bit） |
| `iteLt a b x y` | `if a < b { x } else { y }` | `toNat` の比較 |
| `const n` | `0x…_u64` / `0x…_u128`（n < 2^w。`Kernel.wf`） | `BitVec.ofNat` |

この対応表と rustc だけを信頼する（CONCEPT 5 章）。
-/
import LeanHash.IR.Syntax

namespace LeanHash.IR

def Ty.rust : Ty → String
  | .u64 => "u64"
  | .u128 => "u128"

def hexLit (n : Nat) : String := "0x" ++ String.ofList (Nat.toDigits 16 n)

/-- 式を Rust に。戻り値の Bool は「演算子の式か」（`true` なら、演算子の被演算子やメソッド呼び出しの
レシーバーに置くとき括弧で囲む）。 -/
def Expr.rust : {t : Ty} → Expr t → String × Bool
  | _, .var x => (x, false)
  | t, .const n => (hexLit n ++ "_" ++ t.rust, false)
  | _, .bin op a b =>
    let (sa, oa) := a.rust
    let (sb, ob) := b.rust
    let opnd := fun (s : String) (o : Bool) => if o then "(" ++ s ++ ")" else s
    match op with
    | .add => (opnd sa oa ++ ".wrapping_add(" ++ sb ++ ")", false)
    | .sub => (opnd sa oa ++ ".wrapping_sub(" ++ sb ++ ")", false)
    | .mul => (opnd sa oa ++ ".wrapping_mul(" ++ sb ++ ")", false)
    | .xor => (opnd sa oa ++ " ^ " ++ opnd sb ob, true)
    | .and => (opnd sa oa ++ " & " ++ opnd sb ob, true)
    | .or => (opnd sa oa ++ " | " ++ opnd sb ob, true)
  | _, .shl a k =>
    let (sa, oa) := a.rust
    ((if oa then "(" ++ sa ++ ")" else sa) ++ " << " ++ toString k, true)
  | _, .shr a k =>
    let (sa, oa) := a.rust
    ((if oa then "(" ++ sa ++ ")" else sa) ++ " >> " ++ toString k, true)
  | _, .ext a =>
    let (sa, oa) := a.rust
    ((if oa then "(" ++ sa ++ ")" else sa) ++ " as u128", true)
  | _, .trunc a =>
    let (sa, oa) := a.rust
    ((if oa then "(" ++ sa ++ ")" else sa) ++ " as u64", true)
  | _, .iteLt a b x y =>
    let (sa, oa) := a.rust
    let (sb, ob) := b.rust
    let opnd := fun (s : String) (o : Bool) => if o then "(" ++ s ++ ")" else s
    ("if " ++ opnd sa oa ++ " < " ++ opnd sb ob ++ " { " ++ x.rust.1 ++ " } else { " ++ y.rust.1 ++ " }", true)

def Kernel.rust (k : Kernel) : String :=
  let params := ", ".intercalate (k.params.map fun (x, t) => x ++ ": " ++ t.rust)
  let stmts := k.body.map fun s => "    let " ++ s.name ++ ": " ++ s.ty.rust ++ " = " ++ s.rhs.rust.1 ++ ";\n"
  "/// " ++ k.doc ++ "\n" ++
  "#[inline(always)]\n" ++
  "pub fn " ++ k.name ++ "(" ++ params ++ ") -> " ++ k.retTy.rust ++ " {\n" ++
  String.join stmts ++
  "    " ++ k.ret.rust.1 ++ "\n" ++
  "}\n"

/-- 出力ファイル全体。 -/
def emitRust (ks : List Kernel) : String :=
  "// @generated by `lake exe emit_rust` from LeanHash/Impl/Kernels.lean. DO NOT EDIT.\n" ++
  "//! HashIR から出力した計算の核（P3）。仕様との一致は LeanHash/Impl/Equiv.lean で証明済み。\n" ++
  "//! 再生成: `lake exe emit_rust rust/leanhash/src/kernel.rs`\n" ++
  "#![allow(clippy::all)]\n" ++
  String.join (ks.map fun k => "\n" ++ k.rust)

end LeanHash.IR
